{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "Root user configuration (`config.toml`).",
  "type": "object",
  "properties": {
    "ai": {
      "anyOf": [
        {
          "$ref": "#/$defs/AiConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "backup": {
      "anyOf": [
        {
          "$ref": "#/$defs/BackupConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "env": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "extends": {
      "description": "Optional base configuration to merge before this config.",
      "anyOf": [
        {
          "$ref": "#/$defs/Extends"
        },
        {
          "type": "null"
        }
      ]
    },
    "keyboard": {
      "anyOf": [
        {
          "$ref": "#/$defs/KeyboardConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "package": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackageDeclaration"
      }
    },
    "privacy": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrivacyConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "registry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RegistrySource"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Resource"
      }
    },
    "schema-version": {
      "description": "Kaizen config schema version. The v1 engine accepts only `1`.",
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "system": {
      "anyOf": [
        {
          "$ref": "#/$defs/SystemConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal": {
      "anyOf": [
        {
          "$ref": "#/$defs/TerminalConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "ui": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiConfig"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema-version"
  ],
  "$defs": {
    "AiConfig": {
      "type": "object",
      "properties": {
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "models": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "BackupConfig": {
      "type": "object",
      "properties": {
        "directory": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "max-generations": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Extends": {
      "description": "Reference to an inherited local, Git, or URL configuration.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "type"
      ]
    },
    "KeyboardConfig": {
      "type": "object",
      "properties": {
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "langmap": {
          "anyOf": [
            {
              "$ref": "#/$defs/LangmapConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyboardLayout"
            },
            {
              "type": "null"
            }
          ]
        },
        "use-fn-keys": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "KeyboardLayout": {
      "type": "string",
      "enum": [
        "qwerty",
        "dvorak",
        "colemak",
        "colemak-dh"
      ]
    },
    "LangmapConfig": {
      "description": "Keyboard mapping keys are intentionally dynamic single-character strings.",
      "type": "object",
      "properties": {
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "PackageDeclaration": {
      "type": "object",
      "properties": {
        "arguments": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "type"
      ]
    },
    "PrivacyConfig": {
      "type": "object",
      "properties": {
        "ai-validation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allow-dependencies": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allow-post-install": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "check-hash": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "foss": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "quarantine": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+[wdmy]$"
        }
      },
      "additionalProperties": false
    },
    "RegistrySource": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "type"
      ]
    },
    "Resource": {
      "type": "object",
      "properties": {
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "type"
      ]
    },
    "SourceType": {
      "description": "Source kind for registries, resources, and package declarations.",
      "type": "string",
      "enum": [
        "local",
        "git",
        "url"
      ]
    },
    "SystemConfig": {
      "type": "object",
      "properties": {
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "full_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "TerminalAlias": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "description"
      ]
    },
    "TerminalConfig": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/TerminalAlias"
          }
        },
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ThemeConfig": {
      "type": "object",
      "properties": {
        "dark": {
          "type": [
            "string",
            "null"
          ]
        },
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "light": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "TypographyConfig": {
      "type": "object",
      "properties": {
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "font_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "font_size": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "UiConfig": {
      "type": "object",
      "properties": {
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThemeConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "typography": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypographyConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "wallpaper": {
          "anyOf": [
            {
              "$ref": "#/$defs/WallpaperConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaces": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspacesConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "WallpaperConfig": {
      "type": "object",
      "properties": {
        "directory": {
          "type": [
            "string",
            "null"
          ]
        },
        "directory_dark": {
          "type": [
            "string",
            "null"
          ]
        },
        "directory_light": {
          "type": [
            "string",
            "null"
          ]
        },
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "WorkspacesConfig": {
      "type": "object",
      "properties": {
        "extends": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extends"
            },
            {
              "type": "null"
            }
          ]
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
