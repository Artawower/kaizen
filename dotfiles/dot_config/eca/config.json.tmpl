{
  "defaultModel": "{{ .models.default }}",
  "defaultAgent": "code",
  "rules": [
    {
      "path": "{{ .chezmoi.homeDir }}/.config/eca/rules/common-rules.md"
    }
  ],
  "hooks": {
    "notify-me": {
      "type": "postRequest",
      "actions": [
        {
          "type": "shell",
          "shell": "terminal-notifier -title \"Eca\" -message \"Hey, prompt finished!\""
        },
        {
          "type": "shell",
          "shell": "LOG=\"$HOME/.config/eca/ntfy-hook.log\"; TOPIC=\"${ECA_NTFY_TOPIC:-$OPENCODE_NTFY_TOPIC}\"; if [ -z \"$TOPIC\" ] && [ -f \"$HOME/.config/eca/ntfy-topic\" ]; then TOPIC=\"$(tr -d '\\r\\n' < \"$HOME/.config/eca/ntfy-topic\")\"; fi; { printf '%s stage=start topic=%s\\n' \"$(date -Is)\" \"${TOPIC:-<empty>}\"; printf '%s path=%s\\n' \"$(date -Is)\" \"$PATH\"; command -v ntfy >/dev/null 2>&1 && printf '%s ntfy=ntfy\\n' \"$(date -Is)\" || printf '%s ntfy=<missing>\\n' \"$(date -Is)\"; } >> \"$LOG\"; if [ -z \"$TOPIC\" ]; then printf '%s error=missing-topic\\n' \"$(date -Is)\" >> \"$LOG\"; exit 1; fi; if ntfy publish --title \"ECA\" --priority high --tags computer \"$TOPIC\" \"ECA prompt finished\" >> \"$LOG\" 2>&1; then printf '%s stage=published\\n' \"$(date -Is)\" >> \"$LOG\"; else printf '%s error=publish-failed\\n' \"$(date -Is)\" >> \"$LOG\"; exit 1; fi"
        }
      ]
    },
    "notify-approval": {
      "type": "preToolCall",
      "matcher": ".*eca_edit_file",
      "visible": false,
      "actions": [
        {
          "type": "shell",
          "shell": "terminal-notifier -title \"ECA Approval Required\" -message \"Tool approval requested: $(jq -r '.\"tool-name\" // \"Unknown tool\"' <<< \"$1\")\" || osascript -e 'display notification \"Tool approval requested: '$(jq -r '.\"tool-name\" // \"Unknown tool\"' <<< \"$1\")'\" with title \"ECA Approval Required\"'"
        }
      ]
    }
  },
  "skills": [
    {
      "path": "{{ .chezmoi.homeDir }}/.agents/skills/playwright-cli"
    }
  ],
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--enable-web-dashboard",
        "false"
      ]
    },
    "emacs-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@keegancsmith/emacs-mcp-server"
      ],
      "disabled": true
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "disabled": true
    },
    "deepcontext": {
      "command": "npx",
      "args": [
        "-y",
        "@wildcard-ai/deepcontext@latest"
      ],
      "disabled": true
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp",
      "disabled": true
    },
    "qmd": {
      "command": "qmd",
      "args": [
        "mcp"
      ],
      "disabled": true
    }
  },
  "completion": {
    "model": "ollama/qwen2.5-coder:1.5b"
  },
  "prompts": {
    "completion": "${file:{{ .chezmoi.homeDir }}/.config/eca/agents/completion.md}"
  },
  "$schema": "https://eca.dev/config.json",
  "mcpToolSearch": {
    "includePattern": [
      ".*"
    ]
  }
}
