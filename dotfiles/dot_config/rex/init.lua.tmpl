{{- $shell := lookPath .terminal.shell -}}
{{- if not $shell -}}
{{- fail (printf "Rex requires the configured shell %q on PATH" .terminal.shell) -}}
{{- end -}}
rex.action{
  name = "session_goto",
  title = "Go to Session by Index",
  args = { index = "number" },
  run = function(ctx, args)
    local session = rex.call("session.list", {}).sessions[args.index]
    if session then
      rex.client.queue("session.select", { session_id = session.session_id })
    end
  end,
}

rex.action{
  name = "focus_keep_zoom",
  title = "Focus Pane, Keeping Zoom",
  args = { direction = "string" },
  run = function(ctx, args)
    local view = rex.session.view{}
    local zoomed = false
    for _, window in ipairs(view.windows) do
      if window.window_id == view.active_window_id then
        zoomed = window.zoomed_block_id ~= nil
      end
    end
    if args.direction == "next" then
      rex.session.focus_next_pane{}
    elseif args.direction == "previous" then
      rex.session.focus_previous_pane{}
    else
      rex.session.focus_direction{ direction = args.direction }
    end
    if zoomed then
      rex.session.zoom_block{ zoom = true }
    end
  end,
}

rex.action{
  name = "scratch_toggle",
  title = "Toggle Scratch Terminal",
  run = function(ctx, args)
    local view = rex.session.view{}
    local window
    for _, candidate in ipairs(view.windows) do
      if candidate.window_id == view.active_window_id then
        window = candidate
      end
    end
    for _, layer in ipairs(window.layers) do
      if layer.kind ~= "tiled" and layer.blocks[1] and layer.blocks[1].label == "scratch" then
        local hidden = layer.state == "minimized"
        rex.session.set_layer_state{ layer_id = layer.layer_id, state = hidden and "normal" or "minimized", focus = hidden }
        return
      end
    end
    rex.session.new_layer{
      window_id = window.window_id,
      bounds = { 0.1, 0.1, 0.8, 0.8 },
      focus = true,
      layout = { block = { flavor = "com.superlogical.terminal.shell", label = "scratch", options = { shell = {{ $shell | quote }} } } },
    }
  end,
}

