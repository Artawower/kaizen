{
  "ai": {
    "bump": {
      "before": [
        {
          "onFailure": "warn",
          "run": [
            "pi",
            "update",
            "--extensions"
          ]
        }
      ],
      "capture": [
        "~/.pi/agent/settings.json"
      ],
      "run": []
    },
    "category": "ai",
    "description": "AI coding agents and tooling",
    "update": [
      {
        "onFailure": "warn",
        "run": [
          "pi",
          "update",
          "--extensions"
        ]
      }
    ]
  },
  "android": {
    "category": "dev",
    "description": "Android development: Android Studio"
  },
  "api": {
    "category": "dev",
    "description": "API client tools: Hoppscotch"
  },
  "battery-thresholds": {
    "category": "system",
    "description": "Battery charge threshold management"
  },
  "browser": {
    "category": "desktop",
    "description": "Web browser: Zen"
  },
  "containers": {
    "category": "dev",
    "description": "Container and VM tooling: OrbStack"
  },
  "core": {
    "category": "system",
    "description": "Core CLI utilities"
  },
  "database": {
    "category": "dev",
    "description": "Database GUI tools: SQLite Browser, MongoDB Compass"
  },
  "desktop": {
    "category": "desktop",
    "description": "Desktop utilities: launcher, menu bar, file manager, cleaner"
  },
  "emacs": {
    "category": "editor",
    "description": "Emacs editor"
  },
  "fonts": {
    "category": "system",
    "description": "Fonts and Nerd Fonts"
  },
  "frontend": {
    "category": "dev",
    "description": "Frontend development tooling"
  },
  "go": {
    "category": "dev",
    "description": "Go development tooling"
  },
  "helix": {
    "category": "editor",
    "description": "Helix editor + marksman LSP"
  },
  "keyboard": {
    "category": "system",
    "description": "Keyboard layout tooling"
  },
  "media": {
    "category": "media",
    "description": "Media players: VLC, Spotube"
  },
  "mise": {
    "bump": {
      "before": [
        {
          "onFailure": "fail",
          "run": [
            "mise",
            "install"
          ]
        }
      ],
      "capture": [
        "~/.config/mise.lock"
      ],
      "run": [
        {
          "onFailure": "fail",
          "run": [
            "~/.config/scripts/mise-bump"
          ]
        }
      ]
    },
    "category": "dev",
    "description": "Mise toolchains",
    "update": []
  },
  "nix-system": {
    "bump": {
      "before": [],
      "capture": [
      ],
      "run": [
        {
          "onFailure": "fail",
          "run": [
            "nix",
            "flake",
            "update",
            "--flake",
            "~/.config/nix"
          ]
        }
      ]
    },
    "category": "system",
    "description": "Nix flake inputs",
    "update": []
  },
  "productivity": {
    "category": "productivity",
    "description": "Productivity tools: notes, tasks, time-tracking, voice"
  },
  "python": {
    "category": "dev",
    "description": "Python development tooling"
  },
  "rust": {
    "category": "dev",
