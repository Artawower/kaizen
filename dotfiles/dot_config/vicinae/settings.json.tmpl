// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config
{{- if eq .chezmoi.os "darwin" }}
{
   "$schema": "https://vicinae.com/schemas/config.json",
   "pop_to_root_on_close": true,
   "font": {
      "rendering": "qt",
      "normal": {}
   },
   "theme": {
      "light": {
         "name": "catppuccin-latte",
         "icon_theme": "Hicolor"
      },
      "dark": {
         "name": "dracula",
         "icon_theme": "Hicolor"
      }
   },
   "launcher_window": {
      "opacity": 0.85,
      "compact_mode": {
         "enabled": true
      }
   },
   "keybinds": {
      "toggle-action-panel": "control+K"
   },
   "favorites": [
      "clipboard:history",
      "core:search-emojis",
      "applications:com.mattermost.Desktop",
      "applications:org.telegram"
   ],
   "providers": {
      "@benvp/store.raycast.audio-device": {
         "preferences": {
            "favourite": "",
            "favourite2": "",
            "systemOutput": true
         }
      },
      "@lardissone/store.raycast.raindrop-io": {
         "preferences": {
            "additionalItemToDisplayInList": "link",
            "displayDate": "lastUpdated",
            "fetchAllResults": true,
            "sortBy": "",
            "tagsDisplay": "1",
            "titleOnly": false,
            "useLastCollection": false
         },
         "entrypoints": {
            "search": {
               "shortcut": "control+shift+L"
            }
         }
      },
      "applications": {
         "preferences": {
            "paths": [
               "{{ .chezmoi.homeDir }}/.local/share/applications",
               "{{ .chezmoi.homeDir }}/.nix-profile/share/applications",
               "{{ .chezmoi.homeDir }}/.config/vicinae"
            ]
         },
         "entrypoints": {
            "org.gnome.Ptyxis": {
               "enabled": false
            }
         }
      },
      "clipboard": {
         "entrypoints": {
            "history": {
               "alias": "cp",
               "shortcut": "control+SPACE"
            }
         }
      },
      "core": {
         "entrypoints": {
            "about": {
               "enabled": false
            },
            "documentation": {
               "enabled": true
            },
            "manage-fallback": {
               "enabled": false
            },
            "report-bug": {
               "enabled": true
            },
            "search-emojis": {
               "alias": "sm",
               "shortcut": "alt+shift+K"
            },
            "sponsor": {
               "enabled": false
            }
         }
      },
      "manage-shortcuts": {
         "enabled": false
      },
      "snippets": {
         "enabled": false
      },
      "wm": {
         "entrypoints": {
            "switch-windows": {
               "shortcut": "alt+TAB"
            }
         }
      }
   }
}
{{- else }}
{
   "$schema": "https://vicinae.com/schemas/config.json",
   "pop_to_root_on_close": true,
   "theme": {
      "light": {
         "name": "noctalia",
         "icon_theme": "Hicolor"
      },
      "dark": {
         "name": "noctalia",
         "icon_theme": "Hicolor"
      }
   },
   "launcher_window": {
      "opacity": 0.95
   },
   "keybinds": {
      "toggle-action-panel": "super+K"
   },
   "favorites": [
      "clipboard:history",
      "core:search-emojis",
      "applications:com.mattermost.Desktop",
      "applications:org.telegram"
   ],
   "providers": {
      "applications": {
         "preferences": {
            "paths": [
               "{{ .chezmoi.homeDir }}/.local/share/applications",
               "/nix/store/7swls12w7nxpnqwgyc4my85l9jw0s51x-vicinae-0.18.3/share/applications",
               "/nix/store/zcw1bhk79g80hs9f2l5zsb5w1xsb4y6c-cups-2.4.16/share/applications",
               "/var/lib/flatpak/exports/share/applications",
               "/usr/local/share/applications",
               "/usr/share/applications",
               "{{ .chezmoi.homeDir }}/.nix-profile/share/applications",
               "{{ .chezmoi.homeDir }}/.config/scripts",
               "{{ .chezmoi.homeDir }}/.config/vicinae"
            ]
         },
         "entrypoints": {
            "org.gnome.Ptyxis": {
               "enabled": false
            }
         }
      },
      "clipboard": {
         "entrypoints": {
            "history": {
               "alias": "cp"
            }
         }
      },
      "core": {
         "entrypoints": {
            "search-emojis": {
               "alias": "sm"
            }
         }
      }
   }
}
{{- end }}