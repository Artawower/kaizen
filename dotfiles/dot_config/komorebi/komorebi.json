{
  "default_workspace_padding": 10,
  "default_container_padding": 10,
  "mouse_follows_focus": true,
  "focus_follows_mouse": true,

  "border_width": 10,

  "border_colours": {
    "single": { "r": 139, "g": 92, "b": 246 },
    "stack": { "r": 91, "g": 33, "b": 182 },
    "monocle": { "r": 139, "g": 92, "b": 246 },
    "floating": { "r": 46, "g": 42, "b": 58 },
    "unfocused": { "r": 46, "g": 42, "b": 58 }
  },

  "monitors": [
    {
      "workspaces": [
        {
          "name": "social",
          "layout": "BSP",
          "initial_workspace_rules": [
            { "kind": "Exe", "id": "Telegram", "matching_strategy": "Equals" },
            { "kind": "Exe", "id": "Discord", "matching_strategy": "Equals" },
            {
              "kind": "Exe",
              "id": "Mattermost",
              "matching_strategy": "Equals"
            },
            { "kind": "Exe", "id": "Slack", "matching_strategy": "Equals" }
          ]
        },
        {
          "name": "term",
          "layout": "BSP",
          "initial_workspace_rules": [
            { "kind": "Exe", "id": "Ghostty", "matching_strategy": "Equals" },
            { "kind": "Exe", "id": "kitty", "matching_strategy": "Equals" }
          ]
        },
        {
          "name": "dev",
          "layout": "BSP",
