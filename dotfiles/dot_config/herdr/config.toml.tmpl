{{- define "herdr.keybindings" -}}
{{- $result := list -}}
{{- range $binding := .bindings -}}
{{- $result = append $result $binding -}}
{{- $parts := splitList "+" $binding -}}
{{- $key := last $parts -}}
{{- range $language, $aliasMap := $.aliases -}}
{{- $alias := index $aliasMap $key -}}
{{- if and $alias (ne $alias $key) -}}
{{- $aliasBinding := $alias -}}
{{- if gt (len $parts) 1 -}}
{{- $aliasBinding = printf "%s+%s" (join "+" (slice $parts 0 (sub (len $parts) 1))) $alias -}}
{{- end -}}
{{- $result = append $result $aliasBinding -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- toJson (uniq $result) -}}
{{- end -}}
{{- $shortcuts := .kaizen.shortcuts -}}
{{- if or (eq .layout "colemak-regular") (eq .layout "qwerty") -}}
{{-   $shortcuts = .kaizen.base_shortcuts -}}
{{- end -}}
{{- $paneLeft  := last (index $shortcuts "app.pane.focus.left") -}}
{{- $paneDown  := last (index $shortcuts "app.pane.focus.down") -}}
{{- $paneUp    := last (index $shortcuts "app.pane.focus.up") -}}
{{- $paneRight := last (index $shortcuts "app.pane.focus.right") -}}
{{- $tabPrev   := last (index $shortcuts "app.tab.previous") -}}
{{- $tabNext   := last (index $shortcuts "app.tab.next") -}}
{{- $wsPrev    := last (index $shortcuts "app.workspace.previous") -}}
{{- $wsNext    := last (index $shortcuts "app.workspace.next") -}}
{{- $muxPrefixKeys := index $shortcuts "prefix.multiplexer" -}}
{{- $muxPrefix := $muxPrefixKeys | join "+" | lower -}}
{{- $keyAliases := .kaizen.key_aliases.qwerty -}}
{{- if or (eq .layout "colemak") (eq .layout "colemak-regular") -}}
{{- $keyAliases = .kaizen.key_aliases.colemak -}}
{{- end -}}
{{- $balanceAliases := list -}}
{{- range $language, $aliasMap := $keyAliases -}}
{{- $alias := index $aliasMap "e" -}}
{{- if and $alias (ne $alias "e") -}}
{{- $balanceAliases = append $balanceAliases $alias -}}
{{- end -}}
{{- end -}}
{{- $balanceAliases = uniq $balanceAliases -}}
onboarding = false

[terminal]
default_shell = "xonsh"

[theme]
name = "catppuccin"

[ui.toast]
delivery = "system"

[ui]
show_agent_labels_on_pane_borders = true

[keys]
prefix = {{ template "herdr.keybindings" (dict "bindings" (list $muxPrefix) "aliases" $keyAliases) }}
reload_config = {{ template "herdr.keybindings" (dict "bindings" (list "prefix+shift+r") "aliases" $keyAliases) }}
detach = {{ template "herdr.keybindings" (dict "bindings" (list "prefix+q") "aliases" $keyAliases) }}
workspace_picker = {{ template "herdr.keybindings" (dict "bindings" (list "alt+w" "prefix+w" "super+p") "aliases" $keyAliases) }}
new_workspace = {{ template "herdr.keybindings" (dict "bindings" (list "super+shift+w" "prefix+shift+n") "aliases" $keyAliases) }}
rename_workspace = {{ template "herdr.keybindings" (dict "bindings" (list "super+shift+r") "aliases" $keyAliases) }}
close_workspace = {{ template "herdr.keybindings" (dict "bindings" (list "super+shift+d") "aliases" $keyAliases) }}
new_tab = {{ template "herdr.keybindings" (dict "bindings" (list "alt+shift+t" "prefix+c" "super+t") "aliases" $keyAliases) }}
rename_tab = {{ template "herdr.keybindings" (dict "bindings" (list "super+r") "aliases" $keyAliases) }}
close_tab = {{ template "herdr.keybindings" (dict "bindings" (list "super+x") "aliases" $keyAliases) }}
previous_tab = {{ template "herdr.keybindings" (dict "bindings" (list (printf "super+shift+%s" $tabPrev)) "aliases" $keyAliases) }}
next_tab = {{ template "herdr.keybindings" (dict "bindings" (list (printf "super+shift+%s" $tabNext)) "aliases" $keyAliases) }}
switch_tab = {{ template "herdr.keybindings" (dict "bindings" (list "prefix+1..9") "aliases" $keyAliases) }}
previous_workspace = {{ template "herdr.keybindings" (dict "bindings" (list (printf "super+shift+%s" $wsPrev)) "aliases" $keyAliases) }}
next_workspace = {{ template "herdr.keybindings" (dict "bindings" (list (printf "super+shift+%s" $wsNext)) "aliases" $keyAliases) }}
focus_pane_left = {{ template "herdr.keybindings" (dict "bindings" (list (printf "alt+%s" $paneLeft)) "aliases" $keyAliases) }}
focus_pane_down = {{ template "herdr.keybindings" (dict "bindings" (list (printf "alt+%s" $paneDown)) "aliases" $keyAliases) }}
focus_pane_up = {{ template "herdr.keybindings" (dict "bindings" (list (printf "alt+%s" $paneUp)) "aliases" $keyAliases) }}
focus_pane_right = {{ template "herdr.keybindings" (dict "bindings" (list (printf "alt+%s" $paneRight)) "aliases" $keyAliases) }}
split_vertical = {{ template "herdr.keybindings" (dict "bindings" (list "prefix+v") "aliases" $keyAliases) }}
split_horizontal = {{ template "herdr.keybindings" (dict "bindings" (list "prefix+minus") "aliases" $keyAliases) }}
close_pane = {{ template "herdr.keybindings" (dict "bindings" (list "prefix+x" "alt+q") "aliases" $keyAliases) }}
zoom = {{ template "herdr.keybindings" (dict "bindings" (list "prefix+f" "alt+f") "aliases" $keyAliases) }}
resize_mode = {{ template "herdr.keybindings" (dict "bindings" (list "prefix+r") "aliases" $keyAliases) }}
toggle_sidebar = {{ template "herdr.keybindings" (dict "bindings" (list "prefix+b" "super+b") "aliases" $keyAliases) }}
open_worktree = {{ template "herdr.keybindings" (dict "bindings" (list "alt+p" "prefix+shift+o") "aliases" $keyAliases) }}

[[keys.command]]
key = "prefix+alt+5"
type = "plugin_action"
command = "herdr-tmux-layout.tiled"

[[keys.command]]
key = "prefix+shift+e"
type = "plugin_action"
command = "herdr-tmux-layout.balance"
{{- range $balanceAlias := $balanceAliases }}
[[keys.command]]
key = "prefix+shift+{{ $balanceAlias }}"
type = "plugin_action"
command = "herdr-tmux-layout.balance"
{{- end }}

[keys.indexed]
tabs = "super"
workspaces = "ctrl"

[experimental]
kitty_graphics = true