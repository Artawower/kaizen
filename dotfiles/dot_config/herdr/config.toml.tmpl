{{- $paneLeft  := last (index .kaizen.shortcuts "app.pane.focus.left") -}}
{{- $paneDown  := last (index .kaizen.shortcuts "app.pane.focus.down") -}}
{{- $paneUp    := last (index .kaizen.shortcuts "app.pane.focus.up") -}}
{{- $paneRight := last (index .kaizen.shortcuts "app.pane.focus.right") -}}
{{- $tabPrev   := last (index .kaizen.shortcuts "app.tab.previous") -}}
{{- $tabNext   := last (index .kaizen.shortcuts "app.tab.next") -}}
{{- $wsPrev    := last (index .kaizen.shortcuts "app.workspace.previous") -}}
{{- $wsNext    := last (index .kaizen.shortcuts "app.workspace.next") -}}
{{- $muxPrefixKeys := index .kaizen.shortcuts "prefix.multiplexer" -}}
{{- $muxPrefix := $muxPrefixKeys | join "+" | lower -}}
onboarding = false

[terminal]
default_shell = "xonsh"

[theme]
name = "catppuccin"

[ui.toast]
delivery = "system"

[ui]
show_agent_labels_on_pane_borders = true
agent_panel_scope = "all"

[keys]
prefix = "{{ $muxPrefix }}"
reload_config = "prefix+shift+r"
detach = "prefix+q"
workspace_picker = ["alt+w", "prefix+w", "super+p"]
new_workspace = ["alt+shift+w", "prefix+shift+n"]
rename_workspace = ["alt+r", "super+shift+r"]
close_workspace = ["alt+x", "super+shift+d"]
new_tab = ["alt+shift+t", "prefix+c", "super+t"]
rename_tab = "super+r"
close_tab = "super+x"
previous_tab = "super+shift+{{ $tabPrev }}"
next_tab = "super+shift+{{ $tabNext }}"
switch_tab = "prefix+1..9"
previous_workspace = "super+shift+{{ $wsPrev }}"
next_workspace = "super+shift+{{ $wsNext }}"
focus_pane_left = "alt+{{ $paneLeft }}"
focus_pane_down = "alt+{{ $paneDown }}"
focus_pane_up = "alt+{{ $paneUp }}"
focus_pane_right = "alt+{{ $paneRight }}"
split_vertical = "prefix+v"
split_horizontal = "prefix+minus"
close_pane = ["prefix+x", "alt+q"]
zoom = ["prefix+f", "super+f", "alt+f"]
resize_mode = "prefix+r"
toggle_sidebar = ["prefix+b", "super+b"]
open_worktree = ["alt+p", "prefix+shift+o"]

[keys.indexed]
tabs = "super"
workspaces = "ctrl"
