{
  "settings": {
    "inherit": "helix",
    "init_command": ["enter_helix_mode"],
    "deinit_command": ["exit_helix_mode"]
  },

  "normal": {
    "on_match_failure": "ignore",
    "name": "NOR",
    "line_numbers": "relative",
    "cursor": "block",
    "selection": "inclusive",
    "press": [
      ["ctrl+о", "goto_next_diagnostic"],
      ["ctrl+л", "goto_prev_diagnostic"],
      ["space и и", "switch_buffers"],
      ["space у у", "find_file"],
      ["space г п", "show_diagnostics"],
      ["space г у", "format"],
      ["space г р", "hover"],
      ["space г ы", "rename_symbol"],
      ["space г в", "show_symbols"],
      ["space к к", "open_recent_project"],
      ["space ы а", "run_task"],
      ["space ц й", "close_split"],
      ["space х", "previous_tab"],
      ["space ъ", "next_tab"],
      ["super+shift+р", "previous_tab"],
      ["super+Р", "previous_tab"],
      ["super+shift+г", "next_tab"],
      ["super+Г", "next_tab"],

      ["0", "move_begin"],
      ["$", "move_end"],

      ["ctrl+n", "goto_next_diagnostic"],
      ["ctrl+e", "goto_prev_diagnostic"],

      ["space b b", "switch_buffers"],
      ["space f f", "find_file"],
      ["space l d", "show_diagnostics"],
      ["space l f", "format"],
      ["space l h", "hover"],
      ["space l r", "rename_symbol"],
      ["space l s", "show_symbols"],
      ["space p p", "open_recent_project"],
      ["space r t", "run_task"],
      ["space w q", "close_split"],

      ["space [", "previous_tab"],
      ["space ]", "next_tab"],
      ["super+shift+h", "previous_tab"],
      ["super+shift+l", "next_tab"]
    ]
  },

  "select": {
    "on_match_failure": "ignore",
    "name": "SEL",
    "line_numbers": "relative",
    "cursor": "block",
    "selection": "inclusive",
    "init_command": ["enable_selection"],
    "press": [
      ["ctrl+о", "goto_next_diagnostic"],
      ["ctrl+л", "goto_prev_diagnostic"],
      ["space и и", "switch_buffers"],
      ["space у у", "find_file"],
      ["space г п", "show_diagnostics"],
      ["space г у", "format"],
      ["space г р", "hover"],
      ["space г ы", "rename_symbol"],
      ["space г в", "show_symbols"],
      ["space к к", "open_recent_project"],
      ["space ы а", "run_task"],
      ["space ц й", "close_split"],
      ["space х", "previous_tab"],
      ["space ъ", "next_tab"],
      ["super+shift+р", "previous_tab"],
      ["super+Р", "previous_tab"],
      ["super+shift+г", "next_tab"],
      ["super+Г", "next_tab"],

      ["0", "select_begin"],
      ["$", "select_end"],

      ["ctrl+n", "goto_next_diagnostic"],
      ["ctrl+e", "goto_prev_diagnostic"],

      ["space b b", "switch_buffers"],
      ["space f f", "find_file"],
      ["space l d", "show_diagnostics"],
      ["space l f", "format"],
      ["space l h", "hover"],
      ["space l r", "rename_symbol"],
      ["space l s", "show_symbols"],
      ["space p p", "open_recent_project"],
      ["space r t", "run_task"],
      ["space w q", "close_split"],

      ["space [", "previous_tab"],
      ["space ]", "next_tab"],
      ["super+shift+h", "previous_tab"],
      ["super+shift+l", "next_tab"]
    ]
  }
}
