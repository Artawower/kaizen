bind=SUPER+ALT+SHIFT,n,move_client,down
bind=SUPER+ALT+SHIFT,e,move_client,up
bind=SUPER+ALT+SHIFT,i,move_client,right
bind=CTRL+SUPER+ALT+SHIFT,h,smartresizewin,left
bind=CTRL+SUPER+ALT+SHIFT,n,smartresizewin,down
bind=CTRL+SUPER+ALT+SHIFT,e,smartresizewin,up
bind=CTRL+SUPER+ALT+SHIFT,i,smartresizewin,right
bind=ALT+SHIFT,s,view,1
bind=ALT+SHIFT,t,view,2
bind=ALT+SHIFT,w,view,3
bind=ALT+SHIFT,d,view,4
bind=ALT+SHIFT,o,view,5
