{{ end }}
{{ range $tag := list 1 2 3 4 5 6 7 8 9 }}bind=ALT+SHIFT,{{ $tag }},view,{{ $tag }}
bind=SUPER+ALT+SHIFT,{{ $tag }},tag,{{ $tag }}
