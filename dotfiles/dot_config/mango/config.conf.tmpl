bind=SUPER+ALT+SHIFT,r,tag,6
bind=SUPER+ALT+SHIFT,u,tag,7
bind=SUPER+ALT+SHIFT,l,tag,8
bind=SUPER+ALT+SHIFT,a,tag,9
{{ else }}bind=ALT+SHIFT,h,focus_window_or_workspace,left
bind=ALT+SHIFT,j,focusstack,next
bind=ALT+SHIFT,k,focusstack,prev
bind=ALT+SHIFT,l,focus_window_or_workspace,right
bind=SUPER+ALT+SHIFT,h,move_client,left
bind=SUPER+ALT+SHIFT,j,move_client,down
bind=SUPER+ALT+SHIFT,k,move_client,up
bind=SUPER+ALT+SHIFT,l,move_client,right
bind=CTRL+SUPER+ALT+SHIFT,h,smartresizewin,left
bind=CTRL+SUPER+ALT+SHIFT,j,smartresizewin,down
bind=CTRL+SUPER+ALT+SHIFT,k,smartresizewin,up
bind=CTRL+SUPER+ALT+SHIFT,l,smartresizewin,right
bind=ALT+SHIFT,s,view,1
bind=ALT+SHIFT,t,view,2
