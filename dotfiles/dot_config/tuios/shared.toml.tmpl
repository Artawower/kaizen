{{- $layer := "ctrl+alt+shift" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $layer = "super+alt+shift" -}}
{{- end -}}
{{- $shell := lookPath .terminal.shell -}}
{{- if not $shell -}}
{{- fail (printf "TUIOS requires the configured shell %q on PATH" .terminal.shell) -}}
{{- end -}}
[startup]
tiled = true
daemon = true
layout = "bsp"
open_default_window = true
start_in_terminal_mode = true

[appearance]
preferred_shell = {{ $shell | quote }}
theme = {{ .ui.theme.dark | replace "-" "_" | quote }}
theme_light = {{ if .ui.theme.auto_switch }}{{ .ui.theme.light | replace "-" "_" | quote }}{{ else }}""{{ end }}
glyphs = "default"
border_style = "normal"
window_title_position = "top"
window_title_style = "plain"
shared_borders = false
hide_window_buttons = true
zen_mode = "mouse"
dockbar_position = "top"
show_clock = false
show_cpu = true
show_ram = true
dock_workspace_tabs = true
dock_workspace_tooltip = true
dock_pill_caps = false
dock_prefix_indicator = "badge"
dock_compact = true
dock_workspace_label_max = 4
window_button_style = "dots"
panel_padding = 2
session_border = false
window_title_align = "left"

[spotlight]
enabled = false

[appearance.sidebar]
enabled = false
folder_click = "navigate"
file_actions = true

[agents]
enabled = true

[appearance.sidebar.left]
width = 24

[daemon]
agent_autodetect = true

[workspaces]
new_window_when_empty = true

[notifications.agent]
enabled = true
notify = true

[keybindings]
leader_key = "ctrl+b"
keyboard_layout = "other"
option_glyphs = "type"

