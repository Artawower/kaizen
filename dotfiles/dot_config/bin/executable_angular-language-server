#!/usr/bin/env bash
set -euo pipefail

ngserver_path=$(mise which ngserver 2>/dev/null || command -v ngserver)
server_root=$(node -e '
const fs = require("node:fs");
const path = require("node:path");
const entrypoint = fs.realpathSync(process.argv[1]);
const manifest = require.resolve("@angular/language-server/package.json", {
  paths: [path.dirname(entrypoint)]
});
process.stdout.write(path.dirname(manifest));
' "$ngserver_path")
probe_locations="$PWD/node_modules,$server_root"

exec "$ngserver_path" "$@" \
  --tsProbeLocations "$probe_locations" \
  --ngProbeLocations "$probe_locations"
