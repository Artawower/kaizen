{{- $dataPath := joinPath .chezmoi.homeDir ".config" "kaizen" "data.toml" -}}
{{- $f := dict -}}
{{- if stat $dataPath -}}
{{-   $f = (include $dataPath | fromToml).features -}}
{{- end -}}
[tools]
node = "lts"
pnpm = "10.33.2"

"npm:@tobilu/qmd" = "2.5.3"
"npm:bun" = "latest"

{{ if index $f "vcs" -}}
"cargo:gitu"   = "latest"
"npm:git-trim" = "0.2.1"
{{ end -}}


{{ if or (index $f "terminal") (index $f "emacs") -}}
"npm:typescript-language-server"      = "latest"
"npm:vscode-langservers-extracted"    = "4.10.0"
"npm:yaml-language-server"            = "latest"
"npm:@github/copilot-language-server" = "1.501.0"
"npm:copilot-node-server"             = "1.41.0"
"cargo:kdlfmt"       = "latest"
"cargo:codebook-lsp" = "latest"
"npm:lua-fmt"         = "2.6.0"
{{ end -}}

{{ if index $f "emacs" -}}
"npm:orgnote-cli" = "0.12.4"
"npm:@mermaid-js/mermaid-cli"   = "11.14.0"
"pipx:rassumfrassum"            = "latest"
{{ end -}}

{{ if index $f "frontend" -}}
"npm:typescript"                = "6.0.3"
"npm:prettier"                  = "3.8.3"
"npm:@angular/cli"              = "22.0.0"
"npm:@angular/language-server"  = "22.0.0"
"npm:@angular/language-service" = "22"
"npm:@vue/language-server"      = "2.2.12"
"npm:eslint"                    = "10.4.1"
"npm:stylelint"                 = "17.13.0"
"npm:pretty-ts-errors-markdown" = "0.0.15"
"npm:ngx-unused-css"            = "4.0.0-1"
"npm:playwright"                = "^1.59.1"
"npm:npm-check-updates"         = "22.2.3"
"npm:npm-upgrade"               = "3.3.0"
"npm:env-cmd"                   = "11.0.0"
"npm:yalc"                      = "1.0.0-pre.53"
{{ end -}}



{{ if index $f "go" -}}
"go:golang.org/x/tools/gopls" = "0.20.0"
{{ end -}}

{{ if index $f "python" -}}
"pipx:basedpyright" = "latest"
# "pipx:ty"           = "latest"
"pipx:httpie"       = "latest"
"pipx:pyrefly"      = "latest"
{{ end -}}

{{ if index $f "ai" -}}
"npm:@earendil-works/pi-coding-agent" = "0.78.1"
"npm:opencode-ai"                   = "1.16.2"
"npm:skills"                        = "1.5.10"
"npm:context-mode"                  = "1.0.162"
"npm:pi-link"                       = "0.1.15"
"npm:@mem0/cli"                     = "0.2.8"
"npm:mem0ai"                        = "3.0.6"
"go:github.com/umputun/ralphex/cmd/ralphex" = "latest"
{{ end -}}
