cmd-alt-shift-u = ['move-node-to-workspace THR', 'workspace THR']
cmd-alt-shift-l = ['move-node-to-workspace STU', 'workspace STU']
cmd-alt-shift-p = ['move-node-to-workspace PRD', 'workspace PRD']
