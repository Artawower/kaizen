cmd-alt-shift-2 = ['move-node-to-workspace TRM', 'workspace TRM']
cmd-alt-shift-3 = ['move-node-to-workspace WEB', 'workspace WEB']
cmd-alt-shift-4 = ['move-node-to-workspace DEB', 'workspace DEB']
cmd-alt-shift-5 = ['move-node-to-workspace DEV', 'workspace DEV']
cmd-alt-shift-6 = ['move-node-to-workspace ENT', 'workspace ENT']
cmd-alt-shift-7 = ['move-node-to-workspace THR', 'workspace THR']
cmd-alt-shift-8 = ['move-node-to-workspace STU', 'workspace STU']
cmd-alt-shift-9 = ['move-node-to-workspace AI', 'workspace AI']
cmd-alt-shift-0 = ['move-node-to-workspace PRD', 'workspace PRD']
cmd-alt-shift-minus = ['move-node-to-workspace 11', 'workspace 11']
cmd-alt-shift-equal = ['move-node-to-workspace 12', 'workspace 12']

alt-shift-s = 'workspace SOC'
alt-shift-t = 'workspace TRM'
alt-shift-w = 'workspace WEB'
alt-shift-o = 'workspace DEB'
alt-shift-d = 'workspace DEV'
alt-shift-a = 'workspace AI'

cmd-alt-shift-s = ['move-node-to-workspace SOC', 'workspace SOC']
cmd-alt-shift-t = ['move-node-to-workspace TRM', 'workspace TRM']
cmd-alt-shift-w = ['move-node-to-workspace WEB', 'workspace WEB']
cmd-alt-shift-o = ['move-node-to-workspace DEB', 'workspace DEB']
