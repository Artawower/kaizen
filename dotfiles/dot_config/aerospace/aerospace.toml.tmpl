alt-shift-left = 'workspace --wrap-around prev'
alt-shift-right = 'workspace --wrap-around next'
cmd-alt-shift-left = ['move-node-to-workspace --wrap-around prev', 'workspace --wrap-around prev']
cmd-alt-shift-right = ['move-node-to-workspace --wrap-around next', 'workspace --wrap-around next']

ctrl-alt-shift-left = 'resize width -40'
ctrl-alt-shift-down = 'resize height +40'
ctrl-alt-shift-up = 'resize height -40'
ctrl-alt-shift-right = 'resize width +40'

alt-shift-quote = 'mode service'
cmd-alt-shift-c = 'layout floating tiling'
cmd-alt-shift-v = 'layout tiles accordion'
alt-shift-f = 'fullscreen'
cmd-alt-shift-f = 'macos-native-fullscreen'

alt-shift-enter = 'exec-and-forget open -na Ghostty.app'
cmd-alt-shift-enter = 'exec-and-forget /opt/homebrew/bin/wezterm'

cmd-alt-f = 'exec-and-forget open -a Firefox.app'
cmd-alt-w = 'exec-and-forget open -na Firefox.app'
cmd-alt-t = 'exec-and-forget open -a Telegram.app'
cmd-shift-w = 'exec-and-forget open -a Marta.app'
cmd-alt-r = 'exec-and-forget open -na kitty.app --args "ranger"'
cmd-alt-v = 'exec-and-forget open -na kitty.app --args "nvim"'
cmd-alt-m = 'exec-and-forget open -na kitty.app --args "spt"'

alt-shift-q = 'close'
cmd-alt-shift-x = 'close'
ctrl-alt-shift-0 = 'balance-sizes'

cmd-ctrl-left = 'join-with left'
cmd-ctrl-down = 'join-with down'
cmd-ctrl-up = 'join-with up'
cmd-ctrl-right = 'join-with right'

ctrl-alt-shift-i = 'exec-and-forget nohup /opt/homebrew/bin/wallboy next >> /tmp/wallboy.log 2>&1'
ctrl-alt-shift-d = 'exec-and-forget /opt/homebrew/bin/wallboy save'
ctrl-alt-shift-o = 'exec-and-forget /opt/homebrew/bin/wallboy open'

[mode.service.binding]
esc = ['reload-config', 'mode main']
shift-e = ['flatten-workspace-tree', 'mode main']
r = ['reload-config', 'mode main']
p = ['exec-and-forget walsh set', 'mode main']
backspace = ['close-all-windows-but-current', 'mode main']
b = ['balance-sizes', 'mode main']
c = [
"""exec-and-forget aerospace list-windows --all --json \
  | jq -r '.[] | select(."window-title"=="") | ."window-id"' \
  | xargs -n1 aerospace close --window-id && terminal-notifier "Aerospace Cleanup" -message "Closed empty windows"""",
  'mode main'
]
alt-shift-v = 'split vertical'
alt-shift-b = 'split horizontal'

d = ['exec-and-forget open -a "Emacs Client"', 'mode main']
f = ['exec-and-forget open -a Finder.app', 'mode main']
t = ['exec-and-forget open -a wezterm.app', 'mode main']
m = ['exec-and-forget open -a Telegram.app', 'mode main']
w = ['exec-and-forget open -a Twilight.app', 'mode main']
a = ['exec-and-forget open -a Antigravity.app', 'mode main']

{{ if eq .layout "colemak" }}
h = ['join-with left', 'mode main']
n = ['join-with down', 'mode main']
e = ['join-with up', 'mode main']
i = ['join-with right', 'mode main']
{{ else }}
h = ['join-with left', 'mode main']
j = ['join-with down', 'mode main']
k = ['join-with up', 'mode main']
l = ['join-with right', 'mode main']
{{ end }}

down = 'volume down'
up = 'volume up'
shift-down = ['volume set 0', 'mode main']

# ============================================================================
# AeroSpace Window Rules - Migrated from yabai
# ============================================================================
# Workspace mapping:
# yabai space 1  = SOC (social)
# yabai space 2  = TRM (term)
# yabai space 3  = WEB (www)
# yabai space 4  = DEB (other/debug)
# yabai space 5  = DEV (dev)
# yabai space 6  = ENT (entertainment)
# yabai space 7  = THR (thrash)
# yabai space 8  = STU (study)
# yabai space 9  = AI  (t3)
# yabai space 10 = PRD (load/production)

# ============================================================================
