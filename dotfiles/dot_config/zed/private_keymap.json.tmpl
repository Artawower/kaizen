{{- $appLeft  := last (index .kaizen.shortcuts "app.pane.focus.left") -}}
{{- $appDown  := last (index .kaizen.shortcuts "app.pane.focus.down") -}}
{{- $appUp    := last (index .kaizen.shortcuts "app.pane.focus.up") -}}
{{- $appRight := last (index .kaizen.shortcuts "app.pane.focus.right") -}}
{{- $tabPrev  := last (index .kaizen.shortcuts "app.tab.previous") -}}
{{- $tabNext  := last (index .kaizen.shortcuts "app.tab.next") -}}
{{- $wsPrev   := last (index .kaizen.shortcuts "app.workspace.previous") -}}
{{- $wsNext   := last (index .kaizen.shortcuts "app.workspace.next") -}}
[
  {
    "bindings": {
      "cmd-shift-{{ $tabPrev }}": "pane::ActivatePreviousItem",
      "cmd-shift-{{ $tabNext }}": "pane::ActivateNextItem",
      "cmd-shift-{{ $wsPrev }}": "multi_workspace::PreviousProject",
      "cmd-shift-{{ $wsNext }}": "multi_workspace::NextProject"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-y": "agent::Keep",
      "cmd-n": "agent::Reject",
      "cmd-.": "workspace::ActivateNextPane",
      "ctrl-alt-{{ $appLeft }}": "workspace::ActivatePaneLeft",
      "ctrl-alt-{{ $appDown }}": "workspace::ActivatePaneDown",
      "ctrl-alt-{{ $appUp }}": "workspace::ActivatePaneUp",
      "ctrl-alt-{{ $appRight }}": "workspace::ActivatePaneRight",
      "ctrl-alt-shift-{{ $appLeft }}": ["workspace::MoveItemToPaneInDirection", { "direction": "left" }],
      "ctrl-alt-shift-{{ $appDown }}": ["workspace::MoveItemToPaneInDirection", { "direction": "down" }],
      "ctrl-alt-shift-{{ $appUp }}": ["workspace::MoveItemToPaneInDirection", { "direction": "up" }],
      "ctrl-alt-shift-{{ $appRight }}": ["workspace::MoveItemToPaneInDirection", { "direction": "right" }],
      "cmd-shift-[": "pane::ActivatePreviousItem",
      "cmd-shift-]": "pane::ActivateNextItem",
      "alt-b": "tab_switcher::Toggle",
      "alt-p": "projects::OpenRecent",
      "alt-t": "tab_switcher::Toggle",
      "cmd-\\": "workspace::ToggleBottomDock",
      "cmd-w": "pane::CloseActiveItem",
      "cmd-p": "file_finder::Toggle",
      "cmd-shift-f": "workspace::NewSearch",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-k": "editor::GoToPreviousDiagnostic",
      "ctrl-j": "editor::GoToDiagnostic",
      "cmd-l": "editor::AcceptEditPrediction",
      "cmd-.": "workspace::ActivateNextPane",
      "ctrl-.": "agent::ToggleFocus",
      "cmd-j": "copilot::Suggest",
      "cmd-\\": "workspace::ToggleBottomDock",
      "cmd-<": "zed::OpenKeymap",
      "cmd->": "agent::ToggleFocus",
      "alt-x": "command_palette::Toggle",
      "ctrl-o": "pane::GoBack",
      "ctrl-i": "pane::GoForward",
      "f8": "editor::GoToDiagnostic",
      "cmd-shift-j": "assistant::ToggleFocus",
      "alt-shift-f": "editor::Format",
      "cmd-r": "editor::Rename",
      "cmd-alt-shift-p": "agent::NewThread",
    },
  },
  {
    "context": "Editor && vim_mode == helix_normal",
    "bindings": {
      "space e": "workspace::ToggleLeftDock",
      "space i": "editor::ToggleInlineValues",
    },
  },
  {
    "context": "VimControl",
    "bindings": {
      "space o p": "pane::RevealInProjectPanel",
      "shift-n": [
        "action::Sequence",
        [
          "editor::CopyFileLocation",
          [
            "task::Spawn",
            {
              "task_name": "copy selection with path wrapper"
            }
          ]
        ]
        ],
       "space f f": "command_palette::Toggle",
      "space space": "file_finder::Toggle",
      "space p o": "projects::OpenRecent",
      "ctrl-p": "command_palette::Toggle",
      "cmd-shift-p": "command_palette::Toggle",
      "alt-x": "command_palette::Toggle",
      "space [": "pane::ActivatePreviousItem",
      "space ]": "pane::ActivateNextItem",
      "ctrl-k": "editor::GoToPreviousDiagnostic",
      "ctrl-j": "editor::GoToDiagnostic",
      "cmd-y": "agent::Keep",
      "cmd-n": "agent::Reject",
      "space {{ join " " (index .kaizen.shortcuts "projects.pick") }}": "projects::OpenRecent",
      "cmd-j": "copilot::Suggest",
      "cmd-l": "editor::AcceptEditPrediction",
      "space g R": "editor::ExpandAllDiffHunks",
      "space g r": "editor::ToggleSelectedDiffHunks",
      "space g ]": "editor::GoToHunk",
      "space g [": "editor::GoToPreviousHunk",
      "g ]": "editor::GoToHunk",
      "g [": "editor::GoToPreviousHunk",
      "] g": "editor::GoToHunk",
      "[ g": "editor::GoToPreviousHunk",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] e": ["editor::GoToDiagnostic", { "severity": "error" }],
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": "error" }],
      "space o t": "workspace::ToggleBottomDock",
      "space o T": "workspace::OpenInTerminal",
      "\\ p": "editor::Format",
      "\\m": "pane::JoinAll",
      // "\\h": "editor::ShowHover",
      "space {{ join " " (index .kaizen.shortcuts "vcs.ui") }}": ["task::Spawn", { "task_name": "lazygit" }],
      "space r s": "task::Spawn",
      "space b b": "tab_switcher::Toggle",
      "space b k": "pane::CloseActiveItem",
      "space {{ join " " (index .kaizen.shortcuts "pane.split.right") }}": "pane::SplitRight",
      "space {{ join " " (index .kaizen.shortcuts "pane.split.down") }}": "pane::SplitDown",
      "space w d": "pane::CloseActiveItem",
      "space w h": "workspace::ActivatePaneLeft",
      "space w l": "workspace::ActivatePaneRight",
      "space w k": "workspace::ActivatePaneUp",
      "space w j": "workspace::ActivatePaneDown",
      "ctrl-alt-left": "workspace::ActivatePaneLeft",
      "ctrl-alt-right": "workspace::ActivatePaneRight",
      "ctrl-alt-up": "workspace::ActivatePaneUp",
      "ctrl-alt-down": "workspace::ActivatePaneDown",
      "ctrl-alt-h": "workspace::ActivatePaneLeft",
      "ctrl-alt-j": "workspace::ActivatePaneDown",
      "ctrl-alt-k": "workspace::ActivatePaneUp",
      "ctrl-alt-l": "workspace::ActivatePaneRight",
      "space l r": "editor::Rename",
      "space l a": "editor::ToggleCodeActions",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDefinitionSplit",
      "shift-k": "editor::Hover",
      "space s i": "outline::Toggle",
      "space /": "workspace::NewSearch",
    },
  },
{{- if eq .layout "colemak" }}
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      "n": ["vim::Down", { "display_lines": true }],
      "e": ["vim::Up", { "display_lines": true }],
      "i": "vim::WrappingRight",
      "j": "vim::HelixSelectNext",
      "k": "vim::NextWordEnd",
      "l": "vim::HelixInsert",
      "shift-j": "vim::HelixSelectPrevious",
      "shift-k": ["vim::NextWordEnd", { "ignore_punctuation": true }],
      "shift-l": "vim::InsertFirstNonWhitespace",
      "shift-e": "editor::Hover",
      "g n": "vim::Down",
      "g e": "vim::Up",
      "ctrl-n": "editor::GoToDiagnostic",
      "ctrl-e": "editor::GoToPreviousDiagnostic",
      "space w n": "workspace::ActivatePaneDown",
      "space w e": "workspace::ActivatePaneUp",
      "space w i": "workspace::ActivatePaneRight",
      "ctrl-alt-n": "workspace::ActivatePaneDown",
      "ctrl-alt-e": "workspace::ActivatePaneUp",
      "ctrl-alt-i": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "i": "project_panel::Open",
    },
  },
{{- end }}
  {
    "context": "Terminal",
    "bindings": {
      "cmd-w": "workspace::ToggleBottomDock",
      "ctrl-n": "workspace::NewTerminal",
      "ctrl-s": "terminal::ToggleViMode",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "left": "project_panel::CollapseSelectedEntry",
      "right": "project_panel::ExpandSelectedEntry",
      "l": "project_panel::Open",
      "h": "project_panel::CollapseSelectedEntry",
      "space e": "workspace::ToggleLeftDock",
    },
  },
]
