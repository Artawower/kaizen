[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
center_align = 1

# Natural dynamics without automatic gain adjustment
autosens = 0
sensitivity = 170
scaling = linear

# Allow bars to use the entire panel
max_height = 100

lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = coreaudio
source = 2

[output]
method = noncurses
orientation = bottom
channels = mono
show_idle_bar_heads = 0

[color]
theme = 'none'
gradient = 0
horizontal_gradient = 1

# Catppuccin Mocha
horizontal_gradient_color_1 = '#89b4fa'
horizontal_gradient_color_2 = '#b4befe'
horizontal_gradient_color_3 = '#cba6f7'
horizontal_gradient_color_4 = '#f5c2e7'
horizontal_gradient_color_5 = '#f2cdcd'

[smoothing]
monstercat = 0
waves = 0
noise_reduction = 77