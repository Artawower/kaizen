{{- if eq .chezmoi.os "linux" }}
theme = noctalia
{{- else }}
theme = dark:Gruvbox Material Dark,light:Catppuccin Latte
# theme = dark:TokyoNight,light:Catppuccin Latte
{{- end }}

keybind = clear
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = cmd+n=new_window
keybind = cmd+w=close_surface
keybind = cmd+q=quit
keybind = cmd+shift+comma=reload_config
keybind = cmd+shift+plus=increase_font_size:1
keybind = cmd+shift+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size


window-decoration = false
window-theme = ghostty
macos-non-native-fullscreen = true

window-inherit-working-directory = true
window-inherit-font-size = false

copy-on-select = clipboard
background-opacity = 0.90
background-blur-radius = 10
macos-titlebar-style = "tabs"
window-padding-x = 16,16
window-padding-y = 16,16

font-family = "Myna Nerd Font"
font-size = {{ template "ui-font-size" . }}

macos-option-as-alt = true

shell-integration-features = path
{{- if eq .chezmoi.os "linux" }}
command = xonsh
{{- else }}
command = shell:zsh -l -c 'exec xonsh'
{{- end }}
