{{- $left := "H" -}}
{{- $down := "J" -}}
{{- $up := "K" -}}
{{- $right := "L" -}}
{{- $fullscreen := "F" -}}
{{- if eq .layout "colemak" -}}
{{- $fullscreen = "E" -}}
{{- end }}
[general]
hotkeysEnabled = true
defaultLayoutType = "dwindle"
updateChecksEnabled = true
ipcEnabled = true
animationsEnabled = true

[focus]
followsMouse = false
moveMouseToFocusedWindow = true
followsWindowToMonitor = true
crossesMonitorAtEdge = true
moveCrossesMonitorAtEdge = true

[mouseWarp]
margin = 1
enabled = true
constrainToArrangement = false

[gaps]
size = 20.0

[gaps.outer]
left = 20.0
right = 20.0
top = 20.0
bottom = 20.0

[dwindle]
smartSplit = false
defaultSplitRatio = 1.0
splitWidthMultiplier = 1.0
singleWindowAspectRatio = "fill"
useGlobalGaps = true
moveToRootStable = true

[borders]
enabled = true
width = 2.0

[borders.color]
red = 0.5450980392
green = 0.3607843137
blue = 0.9647058824
alpha = 1.0

[quakeTerminal]
enabled = true
position = "center"
widthPercent = 50.0
heightPercent = 50.0
animationDuration = 0.2
autoHide = false
opacity = 1.0
monitorMode = "focusedWindow"

[[hotkeys]]
id = "focus.left"
binding = "Option+Shift+{{ $left }}"

[[hotkeys]]
id = "focus.down"
binding = "Option+Shift+{{ $down }}"

[[hotkeys]]
id = "focus.up"
binding = "Option+Shift+{{ $up }}"

[[hotkeys]]
id = "focus.right"
binding = "Option+Shift+{{ $right }}"

[[hotkeys]]
id = "focusPrevious"
binding = "Option+Shift+Tab"

[[hotkeys]]
id = "move.left"
binding = "Command+Option+Shift+{{ $left }}"

[[hotkeys]]
id = "move.down"
binding = "Command+Option+Shift+{{ $down }}"

[[hotkeys]]
id = "move.up"
binding = "Command+Option+Shift+{{ $up }}"

[[hotkeys]]
