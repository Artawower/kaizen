#!/usr/bin/env python3
import os
import re
import subprocess
import sys

def _chezmoi_source() -> str:
    result = subprocess.run(["chezmoi", "source-path"], capture_output=True, text=True, check=True)
    return result.stdout.strip()

TEMPLATE         = os.path.join(_chezmoi_source(), "dot_config", "mise.toml.tmpl")
CONFIG           = os.path.expanduser("~/.config/mise.toml")


def run_mise_upgrade():
    result = subprocess.run(["mise", "upgrade", "--bump", "--interactive"])
    if result.returncode == 0:
        return
    if result.returncode == 130:
        sys.exit(0)
    sys.exit(result.returncode)


def read_bumped_versions():
    bumped = {}
    with open(CONFIG) as config:
        for line in config:
            match = re.match(r'^("?[^"={}\n]+"?)\s*=\s*"([^"]+)"', line.strip())
            if match:
                bumped[match.group(1).strip()] = match.group(2)
    return bumped


def update_template(bumped):
    with open(TEMPLATE) as template:
        content = template.read()

    for tool, version in bumped.items():
        if version in ("latest", "lts"):
            continue
        content = re.sub(
            rf'({re.escape(tool)}\s*=\s*")([^"]+)(")',
            rf'\g<1>{version}\g<3>',
            content,
        )

    with open(TEMPLATE, "w") as template:
        template.write(content)


run_mise_upgrade()
update_template(read_bumped_versions())
