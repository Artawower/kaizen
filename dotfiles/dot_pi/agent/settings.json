{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "hideThinkingBlock": true,
  "quietStartup": true,
  "externalEditor": "emacsclient -nw",
  "enableSkillCommands": true,
  "tuiMode": "fullscreen",
  "packages": [
    "npm:@estebanforge/pi-antigravity-bridge",
    "npm:@sherif-fanous/pi-catppuccin",
    "npm:@mjakl/pi-dark-or-light",
    "npm:@thesethrose/pi-zai-provider",
    "npm:pi-alibaba-models",
    "npm:@benvargas/pi-claude-code-use",
    "npm:pi-opencode-bridge",
    "git:github.com/Artawower/pi-servitors",
    "npm:@andrewjacop/pi-herdr",
    {
      "source": "npm:pi-lens",
      "extensions": ["+index.ts"],
      "skills": ["+skills/ast-grep/SKILL.md", "+skills/lsp-navigation/SKILL.md"]
    },
    "npm:pi-secret-guard",
    "npm:pi-notify",
    "npm:pi-copy-output",
    "npm:pi-session-switch",
    "npm:pi-jj-auto",
    "npm:@tomooshi/condensed-milk-pi",
    "npm:pi-observational-memory",
    "npm:@observal/pi-insights",
    "npm:pi-provider-fallback",
    "npm:pi-open-tui",
    "npm:@singh-gur/pi-usage",
    "npm:pi-context-view",
    "npm:pi-trace-extension",
    "npm:pi-open-agents",
    "npm:@soleone/pi-tasks"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "collapseChangelog": true,
  "autocompleteMaxVisible": 3,
  "theme": "catppuccin-macchiato",
  "dark-or-light": {
    "dark": "catppuccin-mocha",
    "light": "catppuccin-latte",
    "default": "light"
  },
  "servitors": {
    "extensions": ["npm:@tian.zuo/pi-antigravity"]
  },
  "lastChangelogVersion": "1.0.2"
}
