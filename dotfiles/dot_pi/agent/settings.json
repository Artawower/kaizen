{
  "hideThinkingBlock": true,
  "quietStartup": true,
  "enableSkillCommands": true,
  "tuiMode": "fullscreen",
  "packages": [
    "npm:@tian.zuo/pi-antigravity",
    "npm:@sherif-fanous/pi-catppuccin",
    "npm:@mjakl/pi-dark-or-light",
    {
      "source": "npm:pi-free",
      "extensions": [
        "-providers/fireworks.ts",
        "-providers/go.ts",
        "-providers/mistral.ts",
        "-providers/nvidia.ts"
      ]
    },
    "npm:@thesethrose/pi-zai-provider",
    "npm:pi-alibaba-models",
    "npm:@benvargas/pi-claude-code-use",
    "npm:pi-opencode-bridge",
    {
      "source": "npm:pi-link",
      "extensions": ["-index.ts"],
      "skills": []
    },
    {
      "source": "git:github.com/HazAT/pi-interactive-subagents",
      "extensions": ["-pi-extension/subagents/index.ts"]
    },
    "npm:@andrewjacop/pi-herdr",
    {
      "source": "npm:pi-lens",
      "extensions": ["+index.ts"],
      "skills": ["+skills/ast-grep/SKILL.md", "+skills/lsp-navigation/SKILL.md"]
    },
    "npm:pi-secret-guard",
    "npm:pi-notify",
    "npm:pi-copy-output",
    "npm:pi-session-switch",
    "npm:pi-jj-auto",
    "npm:@tomooshi/condensed-milk-pi",
    "npm:pi-observational-memory",
    "npm:pi-tool-stats",
    "npm:@observal/pi-insights",
    "npm:pi-provider-fallback",
    "npm:pi-open-tui",
    "npm:@tmustier/pi-usage-extension",
    {
      "source": "npm:@singh-gur/pi-usage",
      "extension": ["-intex.ts"]
    },
    "npm:pi-context-view",

    "npm:@specode/pi-subscription-usage",
    "npm:pi-trace-extension",
    "npm:pi-stats-ext",
    "npm:pi-open-agents"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "collapseChangelog": true,
  "autocompleteMaxVisible": 3,
  "theme": "catppuccin-mocha",
  "dark-or-light": {
    "dark": "catppuccin-mocha",
    "light": "catppuccin-latte",
    "default": "light"
  },
  "lastChangelogVersion": "0.85.1"
}
