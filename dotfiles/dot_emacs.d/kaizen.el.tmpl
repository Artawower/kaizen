;;; kaizen.el --- Machine-specific settings generated by chezmoi -*- lexical-binding: t; -*-
;; DO NOT EDIT — generated from Kaizen data via chezmoi apply

(setq my/font-height {{ template "ui-font-size" . }})

{{ $shortcuts := mergeOverwrite (dict) .kaizen.base_shortcuts -}}
{{- if eq .layout "colemak" -}}
{{-   $shortcuts = mergeOverwrite (dict) .kaizen.shortcuts -}}
{{- else -}}
{{-   $colemakDefaults := dict "nav.down" (list "n") "nav.up" (list "e") "nav.right" (list "i") "nav.insert" (list "l") "app.pane.focus.down" (list "Ctrl" "Opt" "n") "app.pane.focus.up" (list "Ctrl" "Opt" "e") "app.pane.focus.right" (list "Ctrl" "Opt" "i") "app.pane.move.down" (list "Ctrl" "Opt" "Shift" "n") "app.pane.move.up" (list "Ctrl" "Opt" "Shift" "e") "app.pane.move.right" (list "Ctrl" "Opt" "Shift" "i") "app.tab.next" (list "Cmd" "Shift" "i") "app.workspace.next" (list "Cmd" "Shift" "n") "app.workspace.previous" (list "Cmd" "Shift" "e") "fold.next" (list "z" "n") "fold.previous" (list "z" "e") "jjui.new" (list "j") "jjui.edit" (list "k") "jjui.interactive" (list "l") -}}
{{-   range $key, $val := .kaizen.shortcuts -}}
{{-     $isColemakDefault := and (hasKey $colemakDefaults $key) (eq ($val | toJson) ((index $colemakDefaults $key) | toJson)) -}}
{{-     if not $isColemakDefault -}}
{{-       $_ := set $shortcuts $key $val -}}
{{-     end -}}
{{-   end -}}
{{- end }}
(defvar kaizen/preferred-vcs "{{ dig "preferred_vcs" "jj" . }}")
(defvar kaizen/nav-left  "{{ last (index $shortcuts "nav.left") }}")
(defvar kaizen/nav-down  "{{ last (index $shortcuts "nav.down") }}")
(defvar kaizen/nav-up    "{{ last (index $shortcuts "nav.up") }}")
(defvar kaizen/nav-right "{{ last (index $shortcuts "nav.right") }}")
(defvar kaizen/nav-insert "{{ last (index $shortcuts "nav.insert") }}")
(defvar kaizen/line-start "{{ last (index $shortcuts "editor.line.start") }}")
(defvar kaizen/line-end "{{ last (index $shortcuts "editor.line.end") }}")
(defvar kaizen/vcs-ui "{{ join " " (index $shortcuts "vcs.ui") }}")
(defvar kaizen/vcs-history "{{ join " " (index $shortcuts "vcs.history") }}")
(defvar kaizen/binding-scheme "{{ dig "emacs" "binding-scheme" "helixel" . }}")

(provide 'kaizen)
;;; kaizen.el ends here
