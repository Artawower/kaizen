{{- $tools := (fromToml (include "../features/development.toml")).frontend.tools -}}
{{- $vue := index $tools "npm:@vue/language-server" -}}
{{- $vueModules := printf "%s/.local/share/mise/installs/npm-vue-language-server/%s/node_modules" .chezmoi.homeDir $vue -}}
{{- $vuePackage := printf "%s/@vue/language-server" $vueModules -}}
{{- range glob (printf "%s/.mise/@vue+language-server@%s*/node_modules/@vue/language-server" $vueModules $vue) }}{{ $vuePackage = . }}{{ end -}}
{{- $typescript6 := index $tools "npm:@typescript/typescript6" -}}
{{- $typescript6Modules := printf "%s/.local/share/mise/installs/npm-typescript-typescript6/%s/node_modules" .chezmoi.homeDir $typescript6 -}}
{{- $typescript6Server := printf "%s/.mise/@typescript+typescript6@%s/node_modules/@typescript/old/lib/tsserver.js" $typescript6Modules $typescript6 -}}
[language-server.ty]
command = "ty"
args = ["server"]

[language-server.ruff]
command = "ruff"
args = ["server"]

[language-server.codebook]
command = "codebook-lsp"
args = ["serve"]

[language-server.typescript-language-server]
command = "typescript-language-server"
args = ["--stdio"]
config.hostInfo = "Emacs"
config.tsserver.fallbackPath = "{{ $typescript6Server }}"

[language-server.angular]
command = "angular-language-server"
args = ["--stdio"]

[language-server.vtsls.config.javascript.suggest]
completeFunctionCalls = false

[language-server.vtsls.config.typescript.suggest]
completeFunctionCalls = false

[language-server.vtsls.config.vtsls.tsserver]
globalPlugins = [
  { name = "@vue/typescript-plugin", location = "{{ $vuePackage }}", languages = ["vue"], enableForWorkspaceTypeScriptVersions = true, configNamespace = "typescript" }
]

[language-server.vue-language-server]
command = "vue-language-server"
args = ["--stdio", "--tsdk={{ $typescript6Modules }}/@typescript/typescript6/lib"]

[[language]]
name = "vue"
roots = ["package.json"]
language-id = "vue"
file-types = ["vue"]
language-servers = [
  { name = "vue-language-server", support-workspace = ["package.json"], except-features = ["goto-definition", "goto-implementation", "goto-type-definition", "goto-declaration", "goto-reference"] },
  { name = "vtsls", support-workspace = ["package.json"] }
]
  
[language-server.vscode-html-language-server]
command = "vscode-html-language-server"
args = ["--stdio"]

[language-server.gopls]
command = "gopls"

[language-server.rust-analyzer]
command = "rust-analyzer"

[[language]]
name = "python"
language-id = "python"
file-types = ["py", "pyi"]
roots = [
  "pyproject.toml",
  "uv.lock",
  "requirements.txt",
  "setup.py",
  "setup.cfg"
]
language-servers = [
  "ty",
  { name = "ruff", only-features = ["diagnostics", "pull-diagnostics", "code-action", "format"] },
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "javascript"
language-id = "javascript"
file-types = ["js", "mjs", "cjs"]
roots = ["package.json", "jsconfig.json", "tsconfig.json"]
language-servers = [
  { name = "typescript-language-server", support-workspace = ["package.json"] },
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "jsx"
language-id = "javascriptreact"
file-types = ["jsx"]
roots = ["package.json", "jsconfig.json", "tsconfig.json"]
language-servers = [
  { name = "typescript-language-server", support-workspace = ["package.json"] },
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "typescript"
language-id = "typescript"
file-types = ["ts", "mts", "cts"]
roots = ["angular.json", "package.json", "tsconfig.json"]
language-servers = [
  { name = "typescript-language-server", support-workspace = ["angular.json"] },
  { name = "angular", support-workspace = ["angular.json"], config-files = ["angular.json"] },
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "tsx"
language-id = "typescriptreact"
file-types = ["tsx"]
roots = ["package.json", "tsconfig.json"]
language-servers = [
  { name = "typescript-language-server", support-workspace = ["package.json"] },
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]


[[language]]
name = "html"
language-id = "html"
file-types = ["html", "htm"]
roots = ["angular.json", "package.json"]
language-servers = [
  { name = "angular", support-workspace = ["angular.json"], config-files = ["angular.json"] },
  { name = "vscode-html-language-server", support-workspace = ["angular.json", "package.json"] },
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "go"
language-id = "go"
file-types = ["go"]
roots = ["go.work", "go.mod"]
language-servers = [
  "gopls",
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "rust"
language-id = "rust"
file-types = ["rs"]
roots = ["Cargo.toml", "Cargo.lock"]
language-servers = [
  { name = "rust-analyzer", library-directories = ["~/.cargo/registry/src", "~/.rustup/toolchains"] },
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "org"
language-id = "org"
file-types = ["org"]
language-servers = [
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "emacs-lisp"
language-id = "emacs-lisp"
file-types = ["el"]
language-servers = [
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "nu"
language-id = "nu"
file-types = ["nu"]
language-servers = [
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "markdown"
language-id = "markdown"
file-types = ["md", "markdown"]
language-servers = [
  "marksman",
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "toml"
file-types = ["toml", { glob = "pdm.lock" }, { glob = "poetry.lock" }, { glob = "Cargo.lock" }, { glob = "uv.lock" }]
language-servers = [
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "yaml"
file-types = ["yml", "yaml"]
language-servers = [
  "yaml-language-server",
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]

[[language]]
name = "lua"
file-types = ["lua", "rockspec"]
language-servers = [
  "lua-language-server",
  { name = "codebook", only-features = ["diagnostics", "code-action"] }
]
