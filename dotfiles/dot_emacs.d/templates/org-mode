org-mode

(bash-script "#+BEGIN_SRC bash :results output" n> p n "#+END_SRC")
(bash-tangle "#+BEGIN_SRC bash :tangle " (p "file" file) n> p n "#+END_SRC")
(export-latex "#+BEGIN_EXPORT latex" n> p n "#+END_EXPORT")
(src "#+BEGIN_SRC" n> p n "#+END_SRC")
(web "#+BEGIN_SRC web" n> p n "#+END_SRC")
(python "#+BEGIN_SRC python" n> p n "#+END_SRC")
(clojure "#+BEGIN_SRC clojure :results output" n> p n "#+END_SRC")
(res-python "#+BEGIN_SRC python :results output" n> p n "#+END_SRC")
(javascript "#+BEGIN_SRC js :results output" n> p n "#+END_SRC")
(sql "#+BEGIN_SRC sql :results table" n> p n "#+END_SRC")
(json "#+BEGIN_SRC json" n> p n "#+END_SRC")
(html "#+BEGIN_SRC html" n> p n "#+END_SRC")
(go "#+BEGIN_SRC go :results output" n> p n "#+END_SRC")
(docker "#+BEGIN_SRC docker" n> p n "#+END_SRC")
(rust "#+BEGIN_SRC rust :results output" n> p n "#+END_SRC")
(typescript "#+BEGIN_SRC typescript :results output" n> p n "#+END_SRC")
(emacs-lisp "#+BEGIN_SRC emacs-lisp :results silent" n> p n "#+END_SRC")
(h ":PROPERTIES:" n> ":header-args: :tangle no" n> ":END:")
(:header-args: ":PROPERTIES:" n> ":header-args: :tangle no" n> ":END:")
(example "#+BEGIN_EXAMPLE" n> p n "#+END_EXAMPLE")
(quote "#+BEGIN_QUOTE" n> p n "#+END_QUOTE")
(begin-latex "\\begin{aligned}" n p n "\\end{aligned}")

(note ":PROPERTIES:" n
":ID: " (p (org-id-new) note-id) n
":END:" n n
"#+TITLE: " (p "title") n
"#+FILETAGS: " (p "tags") n
"#+STARTUP: " (p "content" startup) n n n
"* Links" n
"- " n
"* Explanation" n
"- " n n)


(pg-note ":PROPERTIES:" n
":ID: " (p (org-id-new) note-id) n
":END:" n n
"#+TITLE: " (p "title") n
"#+DESCRIPTION: " (p "description") n
"#+FILETAGS: " (p "tags") n
"#+STARTUP: " (p "content" startup) n
"#+PROPERTY: header-args:sql :engine postgresql :dbhost 127.0.0.1 :dbport 5432 :dbuser postgres :database demo :results table" n n
"* Links" n
"- " n
"* Explanation" n
"- " n n)

(scss "#+BEGIN_SRC scss" n> p n "#+END_SRC")
(yaml "#+BEGIN_SRC yaml" n> p n "#+END_SRC")

(raindrop "#+BEGIN: raindrop :tags \"" p "\" :smart t" n> n "#+END")


