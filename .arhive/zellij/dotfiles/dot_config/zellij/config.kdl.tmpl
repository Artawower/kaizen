{{- $layer := "Ctrl Alt Shift" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $layer = "Super Alt Shift" -}}
{{- end -}}
keybinds clear-defaults=true {
    locked {
        bind "Ctrl b" "Ctrl и" { SwitchToMode "tmux"; }
    }
    shared {
        bind "{{ $layer }} w" "{{ $layer }} ц" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
        }
        bind "{{ $layer }} t" "{{ $layer }} а" { NewTab; }
        bind "{{ $layer }} r" "{{ $layer }} ы" { SwitchToMode "renametab"; TabNameInput 0; }
        bind "{{ $layer }} x" "{{ $layer }} ч" { CloseTab; }
        bind "Super Shift h" "Super Shift р" { GoToPreviousTab; }
        bind "Super Shift l" "Super Shift г" { GoToNextTab; }
        bind "{{ $layer }} 1" { GoToTab 1; }
        bind "{{ $layer }} 2" { GoToTab 2; }
        bind "{{ $layer }} 3" { GoToTab 3; }
        bind "{{ $layer }} 4" { GoToTab 4; }
        bind "{{ $layer }} 5" { GoToTab 5; }
        bind "{{ $layer }} 6" { GoToTab 6; }
        bind "{{ $layer }} 7" { GoToTab 7; }
        bind "{{ $layer }} 8" { GoToTab 8; }
        bind "{{ $layer }} 9" { GoToTab 9; }
        bind "{{ $layer }} h" "{{ $layer }} р" { MoveFocus "left"; }
        bind "{{ $layer }} j" "{{ $layer }} н" { MoveFocus "down"; }
        bind "{{ $layer }} k" "{{ $layer }} т" { MoveFocus "up"; }
        bind "{{ $layer }} l" "{{ $layer }} г" { MoveFocus "right"; }
        bind "Alt Tab" "{{ $layer }} n" "{{ $layer }} о" { FocusNextPane; }
        bind "Alt Shift Tab" "{{ $layer }} p" "{{ $layer }} к" { FocusPreviousPane; }
        bind "{{ $layer }} d" "{{ $layer }} п" { CloseFocus; }
        bind "{{ $layer }} f" "{{ $layer }} у" { ToggleFocusFullscreen; }
    }
    tmux {
        bind "Ctrl b" "Ctrl и" { Write 2; SwitchToMode "locked"; }
        bind "Esc" "Enter" { SwitchToMode "locked"; }
        bind "q" "й" { Detach; }
        bind "," "б" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "/" "w" "ц" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "c" "с" { NewTab; SwitchToMode "locked"; }
        bind "1" { GoToTab 1; SwitchToMode "locked"; }
        bind "2" { GoToTab 2; SwitchToMode "locked"; }
        bind "3" { GoToTab 3; SwitchToMode "locked"; }
        bind "4" { GoToTab 4; SwitchToMode "locked"; }
        bind "5" { GoToTab 5; SwitchToMode "locked"; }
        bind "6" { GoToTab 6; SwitchToMode "locked"; }
        bind "7" { GoToTab 7; SwitchToMode "locked"; }
        bind "8" { GoToTab 8; SwitchToMode "locked"; }
        bind "9" { GoToTab 9; SwitchToMode "locked"; }
        bind "n" "о" "Tab" { FocusNextPane; SwitchToMode "locked"; }
        bind "p" "к" "Shift Tab" { FocusPreviousPane; SwitchToMode "locked"; }
        bind "v" "м" "|" "\\" { NewPane "right"; SwitchToMode "locked"; }
        bind "-" { NewPane "down"; SwitchToMode "locked"; }
        bind "x" "ч" { CloseFocus; SwitchToMode "locked"; }
        bind "f" "у" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        bind "r" "ы" { SwitchToMode "resize"; }
        bind "Alt h" "Alt р" { Resize "Increase left"; SwitchToMode "locked"; }
        bind "Alt j" "Alt н" { Resize "Increase down"; SwitchToMode "locked"; }
        bind "Alt k" "Alt т" { Resize "Increase up"; SwitchToMode "locked"; }
        bind "Alt l" "Alt г" { Resize "Increase right"; SwitchToMode "locked"; }
        bind "s" "в" { EditScrollback; SwitchToMode "locked"; }
        bind "[" "х" { SwitchToMode "scroll"; }
        bind "g" "е" { ToggleFloatingPanes; SwitchToMode "locked"; }
    }
    resize {
        bind "Esc" "Enter" { SwitchToMode "locked"; }
        bind "h" "р" "Left" { Resize "Increase left"; }
        bind "j" "н" "Down" { Resize "Increase down"; }
        bind "k" "т" "Up" { Resize "Increase up"; }
        bind "l" "г" "Right" { Resize "Increase right"; }
        bind "H" "Р" { Resize "Decrease left"; }
        bind "J" "Н" { Resize "Decrease down"; }
        bind "K" "Т" { Resize "Decrease up"; }
        bind "L" "Г" { Resize "Decrease right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }
    shared_among "scroll" "search" {
        bind "Esc" "q" "й" { ScrollToBottom; SwitchToMode "locked"; }
        bind "j" "н" "Down" { ScrollDown; }
        bind "k" "т" "Up" { ScrollUp; }
        bind "d" "п" { HalfPageScrollDown; }
        bind "u" "ш" { HalfPageScrollUp; }
        bind "Ctrl f" "Ctrl у" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "Ctrl и" "PageUp" { PageScrollUp; }
        bind "e" "л" { EditScrollback; SwitchToMode "locked"; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
    }
    search {
        bind "n" "о" { Search "down"; }
        bind "N" "О" { Search "up"; }
        bind "c" "с" { SearchToggleOption "CaseSensitivity"; }
        bind "w" "ц" { SearchToggleOption "Wrap"; }
        bind "o" "ж" { SearchToggleOption "WholeWord"; }
    }
    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "scroll"; }
        bind "Enter" { SwitchToMode "search"; }
    }
    renametab {
        bind "Ctrl c" "Enter" { SwitchToMode "locked"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "locked"; }
    }
}

plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

theme "catppuccin-frappe"
default_mode "locked"
default_layout "compact"
pane_frames true
copy_command "{{ if eq .chezmoi.os "linux" }}wl-copy{{ else }}pbcopy{{ end }}"
scrollback_editor "hx"
show_startup_tips false

ui {
    pane_frames {
        rounded_corners true
    }
}

floating_panes {
    default_width "80%"
    default_height "80%"
    default_x "10%"
    default_y "10%"
}
